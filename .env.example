# Token de tu bot de Telegram (obtenido con @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID donde se envía el briefing (obtenlo con @userinfobot)
TELEGRAM_CHAT_ID=

# Clave de OpenAI para resúmenes con IA (opcional; si falta se usa un resumen por truncamiento)
OPENAI_API_KEY=

# Modelo de OpenAI a usar (opcional)
OPENAI_MODEL=gpt-4o-mini

# Temas de interés separados por coma (opcional)
NEWS_TOPICS=tecnología, ciberseguridad, cloud

# Máximo de noticias a incluir en el briefing (opcional)
MAX_NEWS=5
